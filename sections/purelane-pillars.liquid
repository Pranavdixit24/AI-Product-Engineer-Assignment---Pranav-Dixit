{% comment %}
  Secondary Section: Pillars ("How it works")
{% endcomment %}

<section class="sec" id="how" data-scene="2">
  <div class="wrap">
    <div class="pillars">
      <article class="glass pillar rv">
        <span class="pi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16.4" cy="6.6" r="2.2"/><circle cx="15" cy="13" r="2.8"/><path d="M4 21h16"/></svg>
        </span>
        <h3 class="d3">{{ section.settings.p1_title | default: 'Less scrubbing' }}</h3>
        <p class="body-s">{{ section.settings.p1_text | default: 'A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.' }}</p>
        <a class="btn btn-ghost btn-sm" href="#shop">Learn more</a>
      </article>

      <article class="glass pillar rv rv-d2">
        <span class="pi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
        </span>
        <h3 class="d3">{{ section.settings.p2_title | default: 'Clean ingredients' }}</h3>
        <p class="body-s">{{ section.settings.p2_text | default: 'No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.' }}</p>
        <a class="btn btn-ghost btn-sm" href="#ingredients">Learn more</a>
      </article>

      <article class="glass pillar rv rv-d3">
        <span class="pi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
        </span>
        <h3 class="d3">{{ section.settings.p3_title | default: 'Safe around everyone' }}</h3>
        <p class="body-s">{{ section.settings.p3_text | default: 'Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.' }}</p>
        <a class="btn btn-ghost btn-sm" href="#proof">Learn more</a>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pillars (How It Works)",
  "settings": [
    { "type": "text", "id": "p1_title", "label": "Pillar 1 Title", "default": "Less scrubbing" },
    { "type": "textarea", "id": "p1_text", "label": "Pillar 1 Content", "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub." },
    { "type": "text", "id": "p2_title", "label": "Pillar 2 Title", "default": "Clean ingredients" },
    { "type": "textarea", "id": "p2_text", "label": "Pillar 2 Content", "default": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food." },
    { "type": "text", "id": "p3_title", "label": "Pillar 3 Title", "default": "Safe around everyone" },
    { "type": "textarea", "id": "p3_text", "label": "Pillar 3 Content", "default": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day." }
  ],
  "presets": [
    { "name": "Purelane Pillars" }
  ]
}
{% endschema %}
