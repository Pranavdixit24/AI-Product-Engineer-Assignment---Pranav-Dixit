{% comment %}
  Header Section for Purelane Theme: Includes Marquee Ticker & Floating Glass Navigation
{% endcomment %}

<!-- ================= TICKER ================= -->
{%- if section.settings.show_ticker -%}
  <div class="ticker" aria-hidden="true">
    <div class="track">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'ticker_item' -%}
            <span>{{ block.settings.text_regular }} <b>{{ block.settings.text_bold }}</b></span>
          {%- endif -%}
        {%- endfor -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'ticker_item' -%}
            <span>{{ block.settings.text_regular }} <b>{{ block.settings.text_bold }}</b></span>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <span>Free shipping <b>on every bundle across India</b></span>
        <span>100% plant-based <b>and non-toxic</b></span>
        <span>Loved by <b>30,000+ happy homes</b></span>
        <span>Buy 3 <b>at flat ₹499</b></span>
        <span>Free shipping <b>on every bundle across India</b></span>
        <span>100% plant-based <b>and non-toxic</b></span>
        <span>Loved by <b>30,000+ happy homes</b></span>
        <span>Buy 3 <b>at flat ₹499</b></span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<!-- ================= NAV ================= -->
<header id="hdr">
  <div class="navpill glass">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      <span class="mark">
        {%- if section.settings.custom_logo != blank -%}
          <img src="{{ section.settings.custom_logo | image_url: width: 40 }}" alt="{{ shop.name | escape }}" width="23" height="23">
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
            <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
            <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
          </svg>
        {%- endif -%}
      </span>
      <span class="txt">
        <span class="n1">{{ section.settings.brand_name | default: 'Purelane' }}</span>
        <span class="n2">{{ section.settings.brand_tagline | default: 'Clean, simply' }}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="#top">Home</a>
        <a href="#ingredients">Ingredients</a>
        <a href="#how">How it works</a>
        <a href="#shop">Shop</a>
        <a href="#bundles">Bundles</a>
      {%- endif -%}
    </nav>

    <div class="navtools">
      <button type="button" class="ico hide-s" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
        </svg>
      </button>
      <a href="{{ routes.account_url }}" class="ico hide-s" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="ico" aria-label="Cart, {{ cart.item_count }} items">
        {%- render 'icon-cart' -%}
        <span class="dot">{{ cart.item_count }}</span>
      </a>
      <button type="button" class="ico burger" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M4 8h16M4 16h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_ticker",
      "label": "Show announcement ticker",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "image_picker",
      "id": "custom_logo",
      "label": "Custom Mark Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu"
    }
  ],
  "blocks": [
    {
      "type": "ticker_item",
      "name": "Ticker Item",
      "settings": [
        {
          "type": "text",
          "id": "text_regular",
          "label": "Regular Text",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text_bold",
          "label": "Bold Highlighted Text",
          "default": "on every bundle across India"
        }
      ]
    }
  ]
}
{% endschema %}
