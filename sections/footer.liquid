{% comment %}
  Footer Section for Purelane Theme
{% endcomment %}

<footer data-scene="4">
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="{{ routes.root_url }}" style="margin-bottom:16px">
          <span class="mark">
            {%- render 'icon-leaf' -%}
          </span>
          <span class="txt">
            <span class="n1">{{ section.settings.brand_name | default: 'Purelane' }}</span>
            <span class="n2">{{ section.settings.brand_tagline | default: 'Clean, simply' }}</span>
          </span>
        </a>
        <p style="max-width:30ch">{{ section.settings.about_text | default: 'Effective cleaning, powered by nature. Made for Indian homes since day one.' }}</p>
      </div>

      <div class="fcol">
        <h5>Shop</h5>
        <a href="#shop">Bestsellers</a>
        <a href="#shop">Kitchen</a>
        <a href="#shop">Laundry</a>
        <a href="#shop">Home</a>
        <a href="#shop">Skin</a>
        <a href="#bundles">Starter kits</a>
      </div>

      <div class="fcol">
        <h5>About</h5>
        <a href="#how">How it works</a>
        <a href="#ingredients">Sustainability</a>
        <a href="#proof">FAQs</a>
        <a href="#voices">Reviews</a>
      </div>

      <div class="fcol">
        <h5>Get in touch</h5>
        {%- if section.settings.email != blank -%}
          <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
        {%- else -%}
          <a href="mailto:hello@purelane.com">hello@purelane.com</a>
        {%- endif -%}

        {%- if section.settings.phone != blank -%}
          <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a>
        {%- else -%}
          <a href="tel:+919930123234">+91 9930 123 234</a>
        {%- endif -%}

        <p style="font-size:12px;color:rgba(236,230,247,.5)">{{ section.settings.company_name | default: 'Purelane Eco Products Pvt Ltd' }}</p>
      </div>
    </div>

    <div class="fbot">
      <span>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'Purelane Eco Products Private Limited' }}</span>
      <span>Privacy · Terms · Refunds · Contact</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact Email",
      "default": "hello@purelane.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Contact Phone",
      "default": "+91 9930 123 234"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company Legal Name",
      "default": "Purelane Eco Products Pvt Ltd"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Purelane Eco Products Private Limited"
    }
  ]
}
{% endschema %}
