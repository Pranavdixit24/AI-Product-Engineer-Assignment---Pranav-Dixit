{% comment %}
  Secondary Section: Newsletter Signup / Club Join
{% endcomment %}

<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Join the Purelane Club' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Get ₹100 off your first bundle' }}</h2>
      <p class="lede" style="margin:0 auto">{{ section.settings.subtext | default: 'Plus first access to new launches and restocks.' }}</p>

      {%- form 'customer', class: 'signup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div style="display:flex; gap:9px; max-width:430px; margin:22px auto 0; flex-wrap:wrap; width:100%;">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder | default: 'your@email.com' }}"
            aria-label="Email address"
            required
            value="{{ form.email }}"
          >
          <button class="btn btn-primary" type="submit">
            {{ section.settings.btn_text | default: 'Get my ₹100 off' }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p style="color:#4f7d10; font-weight:700; margin-top:12px;">Thank you for joining! Check your inbox for your ₹100 off code.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Signup Section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Join the Purelane Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Plus first access to new launches and restocks." },
    { "type": "text", "id": "placeholder", "label": "Email Placeholder", "default": "your@email.com" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Get my ₹100 off" }
  ],
  "presets": [
    { "name": "Purelane Signup" }
  ]
}
{% endschema %}
