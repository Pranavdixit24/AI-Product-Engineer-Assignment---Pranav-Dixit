{% comment %}
  Section 4: Bundles Tier Picker Section
{% endcomment %}

<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker | default: 'Build your bundle' }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'One box. Every room.' }}</h2>
        <p class="lede" style="margin:0 auto">
          {{ section.settings.subtext | default: 'Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.' }}
        </p>
      </div>
    </div>

    <div class="tiers">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <article class="glass tier rv{% if forloop.index == 2 %} rv-d2{% elsif forloop.index == 3 %} rv-d3{% endif %}{% if block.settings.is_best %} best{% endif %}">
            {%- if block.settings.tag_label != blank -%}
              <span class="tag">{{ block.settings.tag_label }}</span>
            {%- endif -%}

            <div class="tierpix{% if block.settings.is_five %} five{% endif %}" aria-hidden="true">
              {%- if block.settings.is_five -%}
                <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
                <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
                <span class="pimg p-floor" role="img" aria-label="Floor cleaner"></span>
                <span class="pimg p-toilet" role="img" aria-label="Toilet cleaner"></span>
                <span class="pimg p-laundry" role="img" aria-label="Laundry detergent"></span>
              {%- elsif block.settings.quantity_count == '2' -%}
                <span class="pimg p-combo2" role="img" aria-label="Product combo"></span>
              {%- else -%}
                <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
                <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
                <span class="pimg p-dish" role="img" aria-label="Dishwash gel"></span>
              {%- endif -%}
            </div>

            <div class="qty">
              {{ block.settings.quantity_count | default: '3' }}
              <small>{{ block.settings.quantity_label | default: 'Products' }}</small>
            </div>

            <div class="price">
              {{ block.settings.price | default: '₹499' }}
              {%- if block.settings.compare_price != blank -%}
                <s>{{ block.settings.compare_price }}</s>
              {%- endif -%}
            </div>

            {%- if block.settings.per_item_note != blank -%}
              <p class="body-s" style="font-size:12px">{{ block.settings.per_item_note }}</p>
            {%- endif -%}

            <ul>
              {%- if block.settings.feature_1 != blank -%}
                <li>{%- render 'icon-check' -%}{{ block.settings.feature_1 }}</li>
              {%- endif -%}
              {%- if block.settings.feature_2 != blank -%}
                <li>{%- render 'icon-check' -%}{{ block.settings.feature_2 }}</li>
              {%- endif -%}
              {%- if block.settings.feature_3 != blank -%}
                <li>{%- render 'icon-check' -%}{{ block.settings.feature_3 }}</li>
              {%- endif -%}
            </ul>

            <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_url | default: '#shop' }}">
              {{ block.settings.button_text | default: 'Build this box' }}
              {%- if block.settings.is_best -%}{%- render 'icon-arrow' -%}{%- endif -%}
            </a>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default 3 Tiers Fallback {%- endcomment -%}
        <article class="glass tier rv">
          <span class="tag">Starter</span>
          <div class="tierpix" aria-hidden="true"><span class="pimg p-combo2" role="img" aria-label="Tap cleaner and kitchen cleaner combo pack"></span></div>
          <div class="qty">2<small>Products</small></div>
          <div class="price">₹349 <s>₹598</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹174 per product</p>
          <ul>
            <li>{%- render 'icon-check' -%}Pick any two products</li>
            <li>{%- render 'icon-check' -%}Free shipping across India</li>
          </ul>
          <a class="btn btn-ghost" href="#shop">Build this box</a>
        </article>

        <article class="glass tier best rv rv-d2">
          <span class="tag">Most popular</span>
          <div class="tierpix" aria-hidden="true">
            <span class="pimg p-kitchen" role="img" aria-label="Foaming kitchen cleaner"></span>
            <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
            <span class="pimg p-dish" role="img" aria-label="Dishwash gel"></span>
          </div>
          <div class="qty">3<small>Products</small></div>
          <div class="price">₹499 <s>₹897</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹166 per product</p>
          <ul>
            <li>{%- render 'icon-check' -%}Pick any three products</li>
            <li>{%- render 'icon-check' -%}Covers kitchen and laundry</li>
            <li>{%- render 'icon-check' -%}Free shipping across India</li>
          </ul>
          <a class="btn btn-primary" href="#shop">Build this box {%- render 'icon-arrow' -%}</a>
        </article>

        <article class="glass tier rv rv-d3">
          <span class="tag">Whole home</span>
          <div class="tierpix five" aria-hidden="true">
            <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
            <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
            <span class="pimg p-floor" role="img" aria-label="Floor cleaner"></span>
            <span class="pimg p-toilet" role="img" aria-label="Toilet cleaner"></span>
            <span class="pimg p-laundry" role="img" aria-label="Laundry detergent"></span>
          </div>
          <div class="qty">5<small>Products</small></div>
          <div class="price">₹799 <s>₹1495</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹160 per product</p>
          <ul>
            <li>{%- render 'icon-check' -%}Pick any five products</li>
            <li>{%- render 'icon-check' -%}Every room in one order</li>
            <li>{%- render 'icon-check' -%}Free shipping across India</li>
          </ul>
          <a class="btn btn-ghost" href="#shop">Build this box</a>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles Tier Picker",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subheading Text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier_card",
      "name": "Bundle Tier Card",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Highlight as Most Popular Tier",
          "default": false
        },
        {
          "type": "text",
          "id": "tag_label",
          "label": "Tier Tag Pill",
          "default": "Starter"
        },
        {
          "type": "text",
          "id": "quantity_count",
          "label": "Product Quantity Count",
          "default": "3"
        },
        {
          "type": "text",
          "id": "quantity_label",
          "label": "Quantity Unit Label",
          "default": "Products"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price Text",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare-at Price Text",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "per_item_note",
          "label": "Per Item Cost Note",
          "default": "Flat ₹166 per product"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Bullet Feature 1",
          "default": "Pick any three products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Bullet Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Bullet Feature 3",
          "default": "Covers kitchen and laundry"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button Link"
        },
        {
          "type": "checkbox",
          "id": "is_five",
          "label": "Use 5-product preview row layout",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles"
    }
  ]
}
{% endschema %}
