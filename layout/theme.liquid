<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="description" content="Plant-based homecare for kitchen, laundry, bathroom and hands. Free shipping across India.">
  {% endif %}
  <meta name="theme-color" content="#eee7fb">
  <link rel="canonical" href="{{ canonical_url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ 'purelane.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>

  {% comment %} Fixed Background Scenes & Animated Water Caustics {% endcomment %}
  <div class="scenes" id="scenes" data-d="1" aria-hidden="true">
    <div class="scene s1 on"></div>
    <div class="scene s2"></div>
    <div class="scene s3"></div>
    <div class="scene s4"></div>

    <div class="water" id="water">
      <div class="wl wl-a">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="cg" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#eafff4" stop-opacity="0"/>
              <stop offset=".18" stop-color="#f2fff8" stop-opacity=".95"/>
              <stop offset=".5" stop-color="#ffffff" stop-opacity="1"/>
              <stop offset=".82" stop-color="#e6fbef" stop-opacity=".9"/>
              <stop offset="1" stop-color="#eafff4" stop-opacity="0"/>
            </linearGradient>
            <filter id="wf" x="-12%" y="-12%" width="124%" height="124%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.0022 0.019" numOctaves="3" seed="21" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="72" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
            <filter id="wf2" x="-12%" y="-12%" width="124%" height="124%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.005 0.031" numOctaves="2" seed="47" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="46" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
          <g filter="url(#wf)">
            <path d="M262 230 Q372 261 482 238 Q592 247 702 250 Q812 210 923 235 Q1033 201 1143 213 Q1253 232 1363 215 Q1473 261 1583 238 Q1694 248 1804 250 Q1914 211 2024 236 Q2134 201 2244 214" stroke="url(#cg)" stroke-width="1.7" fill="none" opacity="0.45" stroke-linecap="round"/>
            <path d="M137 256 Q307 242 477 258 Q646 238 816 245 Q985 259 1155 247 Q1324 277 1494 262 Q1664 267 1833 269 Q2003 243 2172 259 Q2342 237 2512 245" stroke="url(#cg)" stroke-width="5.1" fill="none" opacity="0.23" stroke-linecap="round"/>
            <path d="M389 715 Q514 756 639 725 Q763 738 888 742 Q1013 688 1138 721 Q1262 674 1387 692 Q1512 716 1636 694 Q1761 756 1886 724 Q2010 739 2135 742 Q2260 689 2385 722" stroke="url(#cg)" stroke-width="5.7" fill="none" opacity="0.37" stroke-linecap="round"/>
          </g>
        </svg>
      </div>
      <div class="wl wl-b">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <use href="#wf2"/>
          <g filter="url(#wf2)">
            <path d="M355 217 Q442 234 529 234 Q616 202 703 222 Q790 190 877 203 Q964 215 1051 202 Q1138 242 1225 221 Q1312 235 1399 234 Q1486 202 1573 223" stroke="url(#cg)" stroke-width="3.4" fill="none" opacity="0.17" stroke-linecap="round"/>
          </g>
        </svg>
      </div>
      <div class="wl wl-c">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="sg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#f4fff9" stop-opacity=".85"/>
              <stop offset=".38" stop-color="#dcf6e7" stop-opacity=".28"/>
              <stop offset="1" stop-color="#d4f2e2" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <g>
            <polygon points="95,-80 152,-80 517,1180 439,1180" fill="url(#sg)" opacity="0.26"/>
            <polygon points="433,-80 491,-80 885,1180 807,1180" fill="url(#sg)" opacity="0.41"/>
            <polygon points="751,-80 919,-80 1180,1180 953,1180" fill="url(#sg)" opacity="0.31"/>
          </g>
        </svg>
      </div>
      <div class="wl wl-s">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="sf" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffffff" stop-opacity=".55"/>
              <stop offset=".55" stop-color="#e8fff2" stop-opacity=".16"/>
              <stop offset="1" stop-color="#e8fff2" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <g>
            <rect x="-100" y="-40" width="2000" height="150" fill="url(#sf)"/>
          </g>
        </svg>
      </div>
      <div class="bub">
        <span style="--x:91.9%;--s:6.7px;--dur:21.5s;--dly:19.0s;--drift:-11px"></span>
        <span style="--x:43.4%;--s:5.7px;--dur:26.8s;--dly:16.1s;--drift:-11px"></span>
        <span style="--x:96.6%;--s:6.2px;--dur:13.7s;--dly:10.3s;--drift:38px"></span>
        <span style="--x:6.0%;--s:3.6px;--dur:24.4s;--dly:10.6s;--drift:3px"></span>
        <span style="--x:70.3%;--s:3.3px;--dur:20.9s;--dly:9.2s;--drift:-39px"></span>
        <span style="--x:2.1%;--s:7.1px;--dur:22.0s;--dly:3.1s;--drift:-37px"></span>
      </div>
    </div>
    <div class="vig"></div>
  </div>

  {% section 'header' %}

  <nav class="rail" aria-label="Section progress">
    <a href="#top" class="on" aria-label="Hero"></a>
    <a href="#ingredients" aria-label="Ingredients"></a>
    <a href="#how" aria-label="How it works"></a>
    <a href="#proof" aria-label="Proof"></a>
    <a href="#bundles" aria-label="Bundles"></a>
    <a href="#shop" aria-label="Shop"></a>
    <a href="#voices" aria-label="Reviews"></a>
  </nav>

  <main id="top" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% comment %} Mobile Sticky CTA Bar {% endcomment %}
  <div class="sticky">
    <span class="lbl">
      <b>Pick any 3, pay ₹499</b>
      <span>Free shipping, always</span>
    </span>
    <a class="btn btn-primary btn-sm" href="#bundles">Build bundle</a>
  </div>

  {{ 'purelane.js' | asset_url | script_tag }}
</body>
</html>
